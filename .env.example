# PostgreSQL connection (required)
PG_DSN=postgresql://user:password@localhost:5432/mydb

# Comma-separated NOTIFY channels (required)
PG_CHANNELS=orders,inventory

# Webhook destination (required)
WEBHOOK_URL=https://example.com/webhook

# Optional webhook settings
WEBHOOK_TIMEOUT=30
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_BACKOFF=1.0
# WEBHOOK_HEADERS={"Authorization":"Bearer token","Content-Type":"application/json"}

# Listener settings
LISTEN_TIMEOUT=10
RECONNECT_DELAY=5
WORKER_THREADS=4

# Logging
LOG_LEVEL=INFO
